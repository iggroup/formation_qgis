                          <Option type="QString" value="CASE WHEN @vector_tile_zoom >= 7 AND @vector_tile_zoom &lt;= 8 THEN (scale_exponential(@vector_tile_zoom,7,8,0,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 0.5 ELSE 2 END WHEN &quot;class&quot; = 'trunk' THEN 2 ELSE 2 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 0.5 ELSE 0 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 8 AND @vector_tile_zoom &lt;= 9 THEN (scale_exponential(@vector_tile_zoom,8,9,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 0.5 ELSE 2 END WHEN &quot;class&quot; = 'trunk' THEN 2 ELSE 2 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 0.5 ELSE 0 END END,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 2.25 END WHEN &quot;class&quot; = 'trunk' THEN 2.25 ELSE 2 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 0 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 9 AND @vector_tile_zoom &lt;= 10 THEN (scale_exponential(@vector_tile_zoom,9,10,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 2.25 END WHEN &quot;class&quot; = 'trunk' THEN 2.25 ELSE 2 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 0 END END,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 2.75 END WHEN &quot;class&quot; = 'trunk' THEN 2.75 WHEN (&quot;class&quot; = 'primary') THEN 2.5 WHEN (&quot;class&quot; = 'secondary') THEN 2.5 WHEN (&quot;class&quot; = 'tertiary') THEN 2 WHEN &quot;class&quot; IN ('minor', 'service') THEN 1.5 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 0 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 10 AND @vect