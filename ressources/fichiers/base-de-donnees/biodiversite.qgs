way', 'trunk') THEN color_rgba(255,224,138,255) WHEN &quot;class&quot; IN ('rail', 'path', 'track', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'funicular') THEN color_rgba(243,243,246,0) ELSE color_rgba(243,243,246,255) END ELSE color_rgba(255,255,255,255) END,'lightness'), color_part(CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN color_rgba(255,224,138,255) WHEN &quot;class&quot; IN ('rail', 'path', 'track', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'funicular') THEN color_rgba(243,243,246,0) ELSE color_rgba(243,243,246,255) END ELSE color_rgba(255,255,255,255) END,'alpha')) ELSE color_hsla(color_part(CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN color_rgba(255,224,138,255) WHEN &quot;class&quot; IN ('rail', 'path', 'track', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'funicular') THEN color_rgba(243,243,246,0) ELSE color_rgba(243,243,246,255) END ELSE color_rgba(255,255,255,255) END,'hsl_hue'), color_part(CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN color_rgba(255,224,138,255) WHEN &quot;class&quot; IN ('rail', 'path', 'track', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'funicular') THEN color_rgba(243,243,246,0) ELSE color_rgba(243,243,246,255) END ELSE color_rgba(255,255,255,255) END,'hsl_saturation'), color_part(CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN color_rgba(255,224,138,255) WHEN &quot;class&quot; IN ('rail', 'path', 'track', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'funicular') THEN color_rgba(243,243,246,0) ELSE color_rgba(243,243,246,255) END ELSE color_rgba(255,255,255,255) END,'lightness'), color_part(CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN color_rgba(255,224,138,255) WHEN &quot;class&quot; IN ('rail', 'path', 'track', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'funicular') THEN color_rgba(243,243,246,0) ELSE color_rgba(243,243,246,255) END ELSE color_rgba(255,255,255,255) END,'alpha')) END" name="expression"/>
