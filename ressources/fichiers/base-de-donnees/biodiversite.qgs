t;is_route&quot; = 99) THEN CASE WHEN (&quot;class&quot; = 'transit') THEN 1 WHEN &quot;class&quot; = 'rail' THEN CASE WHEN &quot;subclass&quot; IN ('rail', 'narrow_gauge', 'rack_rail') THEN CASE WHEN &quot;service&quot; IN ('yard', 'siding') THEN 0 ELSE 2 END ELSE 1 END ELSE 0 END ELSE CASE WHEN (&quot;class&quot; = 'cable_car') THEN 1 WHEN &quot;class&quot; IN ('chair_lift', 'gondola') THEN 0.4 ELSE CASE WHEN &quot;subclass&quot; IN ('cable_car', 'funicular') THEN 1 ELSE 0 END END END,CASE WHEN &quot;class&quot; IN ('chair_lift', 'gondola', 'transit') THEN 1.5 ELSE CASE WHEN &quot;service&quot; IN ('yard', 'siding') THEN 1.5 ELSE 2 END END)) * 0.264583 WHEN @vector_tile_zoom > 18 THEN ( ( CASE WHEN &quot;class&quot; IN ('chair_lift', 'gondola', 'transit') THEN 1.5 ELSE CASE WHEN &quot;service&quot; IN ('yard', 'siding') THEN 1.5 ELSE 2 END END ) * 0.264583 ) END) > 0" name="expression"/>
